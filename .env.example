APP_PORT=8000
APP_NAME=行方证书管理后台
SECRET_KEY=please-change-this-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-change-this-password
CHECK_INTERVAL_MINUTES=720
PUBLIC_BASE_URL=http://your-server.example.com:8000
WECHAT_WEBHOOK_URL=
DINGTALK_WEBHOOK_URL=
NOTIFY_COOLDOWN_HOURS=24

# Linux 服务器部署时改成你的 GHCR 镜像地址：
# IMAGE=ghcr.io/<github-owner>/<github-repo>:latest
IMAGE=ghcr.io/your-github-owner/auto-update-ssl-cert:latest

# Web 访问端口，服务器通过 http://服务器IP:APP_PORT 访问。
APP_PORT=8000

# 页面标题。
APP_NAME=行方证书管理后台

# Session 加密密钥，生产环境必须改成随机长字符串。
SECRET_KEY=please-change-this-secret

# 管理员登录用户名。
ADMIN_USERNAME=admin

# 管理员登录密码，生产环境必须修改。
ADMIN_PASSWORD=please-change-this-password

# 定时检查间隔，单位：分钟。720 表示每 12 小时检查一次。
CHECK_INTERVAL_MINUTES=720

# 外部访问后台的完整地址，用于告警消息中的详情链接。
PUBLIC_BASE_URL=http://your-server.example.com:8000

# 企业微信机器人 Webhook，留空表示不启用企业微信通知。
WECHAT_WEBHOOK_URL=

# 钉钉机器人 Webhook，留空表示不启用钉钉通知。
DINGTALK_WEBHOOK_URL=

# 同一类告警的限流时间，单位：小时，避免重复提醒。
NOTIFY_COOLDOWN_HOURS=24

# 应用镜像地址。默认指向本仓库 GitHub Actions 自动构建的 GHCR 镜像。
# 一般不用修改；如需回滚或固定版本，可改为 sha-xxxx、v1.0.0 等标签。
IMAGE=ghcr.io/zhou-jian-qq/auto-update-ssl-cert:latest
